# Mot de passe d'accès (partagé entre François et Guillaume).
# Si vide, l'app est ouverte : à ne faire qu'en local.
APP_PASSWORD=

# Port et interface d'écoute du serveur (prod).
# En prod on écoute sur l'IP de docker0 (172.17.0.1) : nginx (conteneur) la
# joint via host.docker.internal, et le port n'est pas exposé sur Internet.
PORT=3002
HOST=127.0.0.1

# Clé secrète du connecteur MCP pour Claude (lecture seule) :
# adresse https://planning.racines-perspectives.fr/mcp/<MCP_KEY>. Vide = désactivé.
# Générer avec : openssl rand -hex 24
MCP_KEY=
